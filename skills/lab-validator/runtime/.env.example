# ---------------------------------------------------------------------------
# lab-validator configuration template
#
# Copy to `.env` and fill in. `.env` is gitignored — NEVER commit it.
#   Copy-Item .env.example .env
#
# Precedence: real environment variables > .env file.
# In CI, set these as GitHub Actions secrets instead of shipping a .env.
# ---------------------------------------------------------------------------

# --- Skillable Connect LAB API -------------------------------------------
# Sent as the `api_key` HTTP header. Prefer the non-billable integration-testing
# key (5 concurrent instances, 30-minute max lab duration).
# https://docs.skillable.com/apidocs/introduction-studio
LV_SKILLABLE_API_KEY=
LV_SKILLABLE_API_BASE=https://labondemand.com/api/v3

# Skillable TMS API (separate key, separate base URL). Optional.
LV_SKILLABLE_TMS_API_KEY=
LV_SKILLABLE_TMS_API_BASE=https://lms.learnondemand.net/api/2.0

# Stable user id the validator launches labs as (any string your org agrees on).
LV_SKILLABLE_USER_ID=lab-validator
LV_SKILLABLE_USER_EMAIL=

# --- Microsoft Learning Campus (interactive login) ------------------------
# NOTE: there is deliberately NO password variable here.
# MSA/Entra ID enforces MFA and Skillable enforces Device Registration, so a
# stored password cannot log you in. Run `python scripts/bootstrap_auth.py`
# instead: you sign in by hand once, and the resulting session is encrypted to
# your Windows account with DPAPI.
LV_LEARNING_CAMPUS_URL=https://mslearningcampus.com/Pages/ms-learningcampus

# --- Azure oracle access ---------------------------------------------------
# Leave blank. `DefaultAzureCredential` picks up `az login`, and CI should use
# OIDC federation. Storing a client secret here is a downgrade — avoid it.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# --- Runtime ---------------------------------------------------------------
LV_HEADLESS=true
LV_LOG_LEVEL=INFO
# Retain traces/video: never | on-failure | always
LV_ARTIFACT_RETENTION=on-failure
